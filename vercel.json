{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.focusdentalstudios.com" }],
      "destination": "https://focusdentalstudios.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.focusdentalstudios.com" }],
      "destination": "https://focusdentalstudios.com/:path*",
      "permanent": true
    }
  ]
}
